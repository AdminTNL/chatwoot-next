# Variáveis da stack de homologação. Só nomes e valores de exemplo NÃO secretos.
# Os valores reais ficam no Portainer (Environment variables da stack). Nunca versionar.

# Imagem (use a tag sha-<curto> para fixar uma versão)
CHATWOOT_IMAGE=ghcr.io/admintnl/chatwoot-next:develop

# Host público (sugestão, a confirmar) e URL do app
TRAEFIK_HOST=homolog-chatwoot.example.com
FRONTEND_URL=https://homolog-chatwoot.example.com

RAILS_ENV=production

# Gerar um valor próprio, DIFERENTE da produção (openssl rand -hex 64)
SECRET_KEY_BASE=troque-por-valor-gerado

# Banco próprio da homologação (nunca o da produção)
POSTGRES_DB=chatwoot_hml
POSTGRES_USER=chatwoot_hml
POSTGRES_PASSWORD=troque-por-senha-propria

# SMTP: vazio = sem envio de e-mail (convite e recuperação de senha não funcionam)
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Serviço de sugestão de IA: opcional (vazio desliga o recurso)
AI_SUGGESTION_SERVICE_URL=
AI_SUGGESTION_SERVICE_API_KEY=
